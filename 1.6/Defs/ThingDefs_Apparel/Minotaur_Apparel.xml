    <ThingDef ParentName="ESCP_MinotaurApparelBase">
        <defName>ESCP_Apparel_Minotaur_Warplate</defName>
        <label>Morihaus warplate</label>
        <description>Blackened plate over hardened leather, cut wide enough for a minotaur's shoulders and trimmed in Imperial red. The old Empire once armed the children of Morihaus for its wars, and a few smiths in Cyrodiil still remember the pattern.</description>
        <techLevel>Medieval</techLevel>
        <graphicData>
            <texPath>Things/Apparel/ESCP_Minotaur/Warplate/Warplate</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.1, 1.1)</drawSize>
        </graphicData>
        <recipeMaker Inherit="False">
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <researchPrerequisite>PlateArmor</researchPrerequisite>
            <skillRequirements>
                <Crafting>7</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
            </recipeUsers>
        </recipeMaker>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>200</costStuffCount>
        <costList>
            <Leather_Plain>40</Leather_Plain>
        </costList>
        <statBases>
            <WorkToMake>32000</WorkToMake>
            <MaxHitPoints>360</MaxHitPoints>
            <Mass>22</Mass>
            <StuffEffectMultiplierArmor>1.05</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.2</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>8</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>-0.3</MoveSpeed>
        </equippedStatOffsets>
        <apparel>
            <wornGraphicPath>Things/Apparel/ESCP_Minotaur/Warplate/Warplate</wornGraphicPath>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <layers>
                <li>Middle</li>
                <li>Shell</li>
            </layers>
            <tags Inherit="False">
                <li>ESCP_Minotaur_Warplate</li>
            </tags>
        </apparel>
    </ThingDef>

