<Defs>

    <ThingDef Name="ESCP_MinotaurApparelBase" ParentName="ApparelMakeableBase" Abstract="True">
        <techLevel>Neolithic</techLevel>
        <tradeability>Sellable</tradeability>
        <thingCategories>
            <li>Apparel</li>
        </thingCategories>
        <apparel>
            <tags>
                <li>ESCP_Minotaur_Apparel</li>
            </tags>
            <defaultOutfitTags>
                <li>Worker</li>
                <li>Soldier</li>
            </defaultOutfitTags>
        </apparel>
        <modExtensions>
            <li Class="ESCP.Core.XenotypeExtension">
                <whitelistedXenotypes>
                    <li>ESCP_Xenotype_Minotaur</li>
                </whitelistedXenotypes>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="ESCP_MinotaurApparelBase">
        <defName>ESCP_Apparel_Minotaur_Stone_Shoulder_Armor</defName>
        <label>stone shoulder armor</label>
        <description>A slab of rock lashed to one shoulder with rawhide. Crude, heavy and surprisingly good at turning a blade.</description>
        <graphicData>
            <texPath>Things/Apparel/Minotaur_Stone_Shoulder_Armor/ESCP_Minotaur_Stone_Shoulder_Armor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <recipeMaker Inherit="False">
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Tailor</effectWorking>
            <soundWorking>Recipe_Tailor</soundWorking>
            <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
            <recipeUsers>
                <li>CraftingSpot</li>
            </recipeUsers>
        </recipeMaker>
        <stuffCategories>
            <li>Stony</li>
        </stuffCategories>
        <costStuffCount>45</costStuffCount>
        <statBases>
            <WorkToMake>1800</WorkToMake>
            <Mass>4.5</Mass>
            <StuffEffectMultiplierArmor>0.6</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
        <apparel>
            <wornGraphicPath>Things/Apparel/Minotaur_Stone_Shoulder_Armor/ESCP_Minotaur_Stone_Shoulder_Armor</wornGraphicPath>
            <bodyPartGroups>
                <li>Shoulders</li>
            </bodyPartGroups>
            <layers>
                <li>Middle</li>
            </layers>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="ESCP_MinotaurApparelBase">
