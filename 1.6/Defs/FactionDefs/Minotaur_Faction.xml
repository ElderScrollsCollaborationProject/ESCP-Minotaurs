<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_Minotaur</defName>
        <label>minotaur herds</label>
        <description>The minotaurs of Cyrodiil live in small herds in its forests, caves and Ayleid ruins, far from the roads. They are rare, territorial and almost always hostile. Hunters prize their horns, and the herds remember it.</description>
        <colorSpectrum>
            <li>(0.6, 0.16, 0.14)</li>
        </colorSpectrum>
        <pawnSingular>minotaur</pawnSingular>
        <pawnsPlural>minotaurs</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <fixedName>Children of Morihaus</fixedName>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <settlementGenerationWeight>0.1</settlementGenerationWeight>
        <permanentEnemy>true</permanentEnemy>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <leaderTitle>herd lord</leaderTitle>
        <factionIconPath>World/WorldObjects/ESCP_Minotaur</factionIconPath>
        <settlementTexturePath>World/WorldObjects/Expanding/ESCP_MinotaurSettlement</settlementTexturePath>
        <techLevel>Medieval</techLevel>
        <allowedCultures>
            <li>ESCP_Culture_Minotaur</li>
        </allowedCultures>
        <fixedIdeo>true</fixedIdeo>
        <ideoName>The Blood of Morihaus</ideoName>
        <ideoDescription>Minotaurs keep few rites. They honor Morihaus, the winged bull who carried Alessia's war against the Ayleids, and they remember Alessia as the mother of their line. Everything else is the herd: who leads it, who feeds it and who threatens it.</ideoDescription>
        <deityPresets>
            <li>
                <nameType><name>Morihaus</name><type>the winged bull, first of the herd</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Alessia</name><type>the Slave Queen, mother of the line</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
        </deityPresets>
        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Minotaur_Child</li>
                    <li>ESCP_Backstory_Minotaur_Adult</li>
                </categories>
            </li>
        </backstoryFilters>
        <raidCommonalityFromPointsCurve>
            <points>
                <li>(0, 0.25)</li>
            </points>
        </raidCommonalityFromPointsCurve>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 135)</li>
                <li>(700, 160)</li>
                <li>(1300, 250)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <options>
                    <ESCP_Pawnkind_Minotaur_Brute>10</ESCP_Pawnkind_Minotaur_Brute>
                    <ESCP_Pawnkind_Minotaur_Shaman>2</ESCP_Pawnkind_Minotaur_Shaman>
                    <ESCP_Pawnkind_Minotaur_Lord>1</ESCP_Pawnkind_Minotaur_Lord>
                </options>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Minotaur_Brute>10</ESCP_Pawnkind_Minotaur_Brute>
                    <ESCP_Pawnkind_Minotaur_Shaman>2</ESCP_Pawnkind_Minotaur_Shaman>
                    <ESCP_Pawnkind_Minotaur_Lord>1</ESCP_Pawnkind_Minotaur_Lord>
                </options>
            </li>
        </pawnGroupMakers>
        <modExtensions Inherit="False">
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <preferredHilliness />
                <maxSettlements>2</maxSettlements>
                <allowedBiomes>
                    <li>TemperateForest</li>
                    <li>BorealForest</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </modExtensions>
    </FactionDef>

    <FactionDef ParentName="PlayerFactionBase">
        <defName>ESCP_Faction_Minotaur_Player</defName>
        <label>Herd of Morihaus</label>
        <description>A few minotaurs who have left the wilds behind, and the people foolish or brave enough to live with them.</description>
        <isPlayer>true</isPlayer>
        <techLevel>Medieval</techLevel>
        <basicMemberKind>ESCP_Pawnkind_Minotaur_Settler</basicMemberKind>
        <pawnSingular>minotaur</pawnSingular>
        <pawnsPlural>minotaurs</pawnsPlural>
        <leaderTitle>herd lord</leaderTitle>
        <factionIconPath>World/WorldObjects/ESCP_Minotaur</factionIconPath>
        <colorSpectrum>
            <li>(0.6, 0.16, 0.14)</li>
        </colorSpectrum>
        <allowedCultures>
            <li>ESCP_Culture_Minotaur</li>
        </allowedCultures>
        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Minotaur_Child</li>
                    <li>ESCP_Backstory_Minotaur_Adult</li>
                </categories>
            </li>
        </backstoryFilters>
    </FactionDef>

</Defs>
