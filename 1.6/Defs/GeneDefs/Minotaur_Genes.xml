<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <GeneDef>
        <defName>ESCP_Gene_Minotaur_Form</defName>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <label>minotaur form</label>
        <description>Carriers have the head of a bull, curving horns, a tufted tail and a hide of short fur. No helm made for a man will fit over the horns, and no boot will fit a hoof.</description>
        <iconPath>UI/Icons/Genes/Gene_Furskin</iconPath>
        <displayCategory>Cosmetic</displayCategory>
        <biostatCpx>0</biostatCpx>
        <tattoosVisible>false</tattoosVisible>
        <hairTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>Bald</li>
            </tags>
        </hairTagFilter>
        <beardTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>NoBeard</li>
            </tags>
        </beardTagFilter>
        <exclusionTags>
            <li>Head</li>
        </exclusionTags>
        <forcedHeadTypes>
            <li>ESCP_HeadMinotaur_Male</li>
            <li>ESCP_HeadMinotaur_Female</li>
        </forcedHeadTypes>
        <renderNodeProperties>
            <li>
                <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
                <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
                <texPaths>
                    <li>Things/Pawn/Humanlike/ESCP_Minotaur/Horns/HornsA</li>
                    <li>Things/Pawn/Humanlike/ESCP_Minotaur/Horns/HornsB</li>
                    <li>Things/Pawn/Humanlike/ESCP_Minotaur/Horns/HornsC</li>
                    <li>Things/Pawn/Humanlike/ESCP_Minotaur/Horns/HornsD</li>
                    <li>Things/Pawn/Humanlike/ESCP_Minotaur/Horns/HornsE</li>
                    <li>Things/Pawn/Humanlike/ESCP_Minotaur/Horns/HornsF</li>
                </texPaths>
                <color>(255, 255, 255)</color>
                <parentTagDef>Head</parentTagDef>
                <rotDrawMode>Fresh, Rotting, Dessicated</rotDrawMode>
                <drawData>
                    <defaultData>
                        <layer>80</layer>
                    </defaultData>
                    <dataNorth>
                        <layer>10</layer>
                    </dataNorth>
                </drawData>
            </li>
            <li>
                <workerClass>PawnRenderNodeWorker_Body</workerClass>
                <texPath>Things/Pawn/Humanlike/ESCP_Minotaur/Tail/Tail</texPath>
                <colorType>Skin</colorType>
                <useSkinShader>true</useSkinShader>
                <useRottenColor>true</useRottenColor>
                <parentTagDef>Body</parentTagDef>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <visibleFacing>
                    <li>East</li>
                    <li>West</li>
                    <li>North</li>
                </visibleFacing>
                <drawData>
                    <defaultData>
                        <layer>-2</layer>
                    </defaultData>
                    <dataNorth>
                        <layer>90</layer>
                    </dataNorth>
                </drawData>
            </li>
        </renderNodeProperties>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Minotaur_Blood</defName>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <label>blood of Morihaus</label>
        <description>Carriers are huge, tireless and terrifying in a fight, but they cannot read, make art or talk anyone into anything. Their hands are too big for a bowstring, and their tempers are worse than their hands.</description>
        <iconPath>UI/Icons/Genes/Gene_Aggressive</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <biostatCpx>0</biostatCpx>
        <disabledWorkTags>
            <li>Intellectual</li>
            <li>Artistic</li>
            <li>Social</li>
        </disabledWorkTags>
        <forcedTraits>
            <li>
                <def>ESCP_Trait_Minotaur_Temper</def>
            </li>
        </forcedTraits>
        <statOffsets>
            <PainShockThreshold>0.15</PainShockThreshold>
            <MeleeHitChance>4</MeleeHitChance>
        </statOffsets>
        <statFactors>
            <ShootingAccuracyPawn>0.5</ShootingAccuracyPawn>
            <SocialImpact>0.5</SocialImpact>
        </statFactors>
    </GeneDef>

