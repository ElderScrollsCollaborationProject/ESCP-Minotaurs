<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ScenarioDef>
        <defName>ESCP_Scenario_Minotaur</defName>
        <label>Herd of Morihaus</label>
        <description>Two minotaurs who walked out of the Cyrodiilic wilds, and the Imperial keeper who talked them into staying. The minotaurs will do the heavy work and the fighting. Someone else will have to do the reading, the trading and the talking them down.</description>
        <scenario>
            <summary>Two minotaurs and their Imperial keeper. Minotaurs cannot research, trade or make art.</summary>
            <playerFaction>
                <def>PlayerFaction</def>
                <factionDef>ESCP_Faction_Minotaur_Player</factionDef>
            </playerFaction>
            <surfaceLayer>
                <def>SurfaceLayerFixed</def>
                <tag>Surface</tag>
                <layer>Surface</layer>
                <settingsDef>Surface</settingsDef>
                <hide>true</hide>
                <connections>
                    <Orbit MayRequire="Ludeon.RimWorld.Odyssey">
                        <zoomMode>ZoomOut</zoomMode>
                    </Orbit>
                </connections>
            </surfaceLayer>
            <parts>
                <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
                    <def>ConfigurePawnsKindDefs</def>
                    <pawnChoiceCount>8</pawnChoiceCount>
                    <kindCounts>
                        <li>
                            <kindDef>ESCP_Pawnkind_Minotaur_Settler</kindDef>
                            <count>2</count>
                            <requiredAtStart>true</requiredAtStart>
                        </li>
                        <li MayRequire="Rick.ESCP.Imperials">
                            <kindDef>ESCP_Pawnkind_Imperial_Settler</kindDef>
                            <count>1</count>
                        </li>
                    </kindCounts>
                </li>
                <li Class="ScenPart_PlayerPawnsArriveMethod">
                    <def>PlayerPawnsArriveMethod</def>
                    <method>Standing</method>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Silver</thingDef>
                    <count>300</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Pemmican</thingDef>
                    <count>320</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineHerbal</thingDef>
                    <count>20</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>WoodLog</thingDef>
                    <count>300</count>
                </li>
            </parts>
        </scenario>
    </ScenarioDef>

</Defs>
